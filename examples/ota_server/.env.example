# OTA server bind address. Cloudflare Tunnel can forward to http://127.0.0.1:${OTA_PORT}.
OTA_HOST=127.0.0.1

# Local HTTP port. Cloudflare HTTPS normally forwards to this port.
OTA_PORT=8080

# Directory containing manifest.json and firmware.bin.
OTA_ROOT=dist

# Shared secret required as: Authorization: Bearer <OTA_API_KEY>
OTA_API_KEY=change-me

# Public HTTPS base URL exposed through Cloudflare. Used by build_ota.sh for
# baked update URLs and by stage_tools.sh for tool package manifests.
OTA_PUBLIC_BASE_URL=https://ota.example.com/

# ES256 private key used only while building signed manifests. Keep it out of dist/.
# OTA_SIGNING_KEY=examples/ota_server/secrets/ota_signing_private_key.pem
OTA_SIGNATURE_KEY_ID=main-2026

# Optional tool SD-root directory used by stage_tools.sh. Relative paths are
# resolved from the repository root when they do not exist from the current
# directory. The directory must contain tools.json.
# TOOL_SOURCE_DIR=private/tool_assets/sdroot
